<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.barash.bh-translate</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>/bin/zsh</string>
    <string>/Users/user/barashhelvadzhaoglu/script/run_translate.sh</string>
  </array>
  <!-- Her gün 06:30 (LebenInsider çevirisi 05:30'da; Gemini kotası çakışmasın) -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Users/user/barashhelvadzhaoglu</string>
  <key>StandardOutPath</key>
  <string>/Users/user/barashhelvadzhaoglu/script/translate_launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/user/barashhelvadzhaoglu/script/translate_launchd.log</string>
</dict>
</plist>
